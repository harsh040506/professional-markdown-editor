# Response headers for Cloudflare Pages / Workers static assets (Netlify reads this format too).
# vercel.json carries the same rules for Vercel. Keep the two in step.
#
# The Content-Security-Policy is the main safety net: the editor renders text from documents, so scripts
# are limited to the app's own files. 'unsafe-inline' is needed only for styles (KaTeX, Mermaid and
# ProseMirror set style attributes). Images may come from any https site, because documents link to them.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self'; manifest-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
